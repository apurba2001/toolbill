<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon: the Toolbill mark alone, as a silhouette.

  Android draws this flattened to one colour at roughly 18dp, so the launcher geometry cannot be
  reused directly - it carries adaptive-icon padding and would render as a small blob in the
  middle of a lot of nothing. Redrawn to fill the box, with the gaps between the bars widened
  well past a pixel so they survive being downscaled into the status bar.

  Renewal reminders used to borrow the calendar glyph from the bottom navigation.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- The normalized total. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.25,3.5 h15.5 a1.25,1.25 0 0 1 0,2.5 h-15.5 a1.25,1.25 0 0 1 0,-2.5 z" />
    <!-- The tools under it. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5.8,8.5 h1.8 a0.8,0.8 0 0 1 0.8,0.8 v7.4 a0.8,0.8 0 0 1 -0.8,0.8 h-1.8 a0.8,0.8 0 0 1 -0.8,-0.8 v-7.4 a0.8,0.8 0 0 1 0.8,-0.8 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.1,8.5 h1.8 a0.8,0.8 0 0 1 0.8,0.8 v3.4 a0.8,0.8 0 0 1 -0.8,0.8 h-1.8 a0.8,0.8 0 0 1 -0.8,-0.8 v-3.4 a0.8,0.8 0 0 1 0.8,-0.8 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16.4,8.5 h1.8 a0.8,0.8 0 0 1 0.8,0.8 v9.4 a0.8,0.8 0 0 1 -0.8,0.8 h-1.8 a0.8,0.8 0 0 1 -0.8,-0.8 v-9.4 a0.8,0.8 0 0 1 0.8,-0.8 z" />
</vector>
